---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Jorge Liauw Calo | Security Engineer at Google Cloud',
  description = 'Security Engineer at Google Cloud with 13+ years of experience in Cybersecurity across Semiconductor, Banking, Fintech, and Insurance.',
  image = '/images/jorge-google-cloud-portrait.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://jorgeliauw.nl');
const currentPath = Astro.url.pathname;

const isHome = currentPath === '/' || currentPath === '';
const isArticles = currentPath.startsWith('/posts');
const isAbout = currentPath.startsWith('/about');
const isContact = currentPath.startsWith('/contact');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- Security Headers via Meta Tags -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://jorgeliauw.nl').toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P8ZKGKRFZ8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-P8ZKGKRFZ8');
    </script>
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 font-sans antialiased selection:bg-blue-500/20 selection:text-blue-900 min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Subtle Light Background Grid & Soft Accents -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f040_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f040_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
      <div class="absolute top-0 left-1/4 w-[550px] h-[550px] bg-blue-400/10 rounded-full blur-[140px]"></div>
      <div class="absolute top-1/3 right-10 w-[450px] h-[450px] bg-emerald-400/10 rounded-full blur-[130px]"></div>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-white/90 border-b border-slate-200/80 shadow-[0_1px_3px_rgba(15,23,42,0.03)]">
      <!-- Top Google 4-Color Accent Bar -->
      <div class="w-full h-[3.5px] grid grid-cols-4">
        <div class="bg-[#4285F4]"></div>
        <div class="bg-[#EA4335]"></div>
        <div class="bg-[#FBBC05]"></div>
        <div class="bg-[#34A853]"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 md:h-20 flex flex-col md:flex-row items-center justify-between gap-3.5 md:gap-4">
        <!-- Brand Identity (Matches Screenshot Design) -->
        <div class="w-full md:w-auto flex items-center justify-between">
          <a href="/" class="flex items-center gap-3.5 group">
            <!-- Rounded White Icon Box with Shield & Green Status Dot -->
            <div class="relative w-11 h-11 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-center justify-center group-hover:border-emerald-500/40 transition-all shrink-0">
              <svg class="w-5 h-5 text-[#1E4620]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-[#34A853] ring-2 ring-white"></span>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="text-base sm:text-lg font-bold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
                  Jorge Liauw Calo
                </span>
                <!-- 4 Google Colored Dots -->
                <span class="inline-flex items-center gap-1" aria-hidden="true">
                  <span class="w-2 h-2 rounded-full bg-[#4285F4]"></span>
                  <span class="w-2 h-2 rounded-full bg-[#EA4335]"></span>
                  <span class="w-2 h-2 rounded-full bg-[#FBBC05]"></span>
                  <span class="w-2 h-2 rounded-full bg-[#34A853]"></span>
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-xs font-medium text-slate-500 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#34A853]"></span>
                <span>Security Engineer @ Google Cloud</span>
              </div>
            </div>
          </a>

          <!-- Mobile LinkedIn Quick Button -->
          <a
            href="https://www.linkedin.com/in/jorgeliauw/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="md:hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/80 transition-colors"
          >
            <svg class="w-3.5 h-3.5 text-[#0A66C2] fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>

        <!-- Segmented Pill Navigation Menu (Visible on Both Desktop & Mobile) -->
        <div class="flex items-center gap-3 w-full md:w-auto justify-center md:justify-end">
          <nav
            aria-label="Primary Navigation"
            class="bg-[#F1F5F9] border border-slate-200/90 rounded-full p-1.5 inline-flex items-center gap-1 shadow-inner w-full sm:w-auto justify-between sm:justify-start"
          >
            <a
              href="/"
              class={`px-4 sm:px-5 py-1.5 rounded-full text-xs sm:text-sm transition-all text-center flex-1 sm:flex-initial ${
                isHome
                  ? 'bg-white text-[#1E4620] font-semibold shadow-sm border border-slate-200/60'
                  : 'text-slate-600 hover:text-slate-900 font-medium'
              }`}
            >
              Home
            </a>
            <a
              href="/posts/"
              class={`px-4 sm:px-5 py-1.5 rounded-full text-xs sm:text-sm transition-all text-center flex-1 sm:flex-initial ${
                isArticles
                  ? 'bg-white text-[#1E4620] font-semibold shadow-sm border border-slate-200/60'
                  : 'text-slate-600 hover:text-slate-900 font-medium'
              }`}
            >
              Articles
            </a>
            <a
              href="/about/"
              class={`px-4 sm:px-5 py-1.5 rounded-full text-xs sm:text-sm transition-all text-center flex-1 sm:flex-initial ${
                isAbout
                  ? 'bg-white text-[#1E4620] font-semibold shadow-sm border border-slate-200/60'
                  : 'text-slate-600 hover:text-slate-900 font-medium'
              }`}
            >
              About
            </a>
            <a
              href="/contact/"
              class={`px-4 sm:px-5 py-1.5 rounded-full text-xs sm:text-sm transition-all text-center flex-1 sm:flex-initial ${
                isContact
                  ? 'bg-white text-[#1E4620] font-semibold shadow-sm border border-slate-200/60'
                  : 'text-slate-600 hover:text-slate-900 font-medium'
              }`}
            >
              Contact
            </a>
          </nav>

          <!-- Desktop LinkedIn Pill Button -->
          <a
            href="https://www.linkedin.com/in/jorgeliauw/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/90 shadow-sm transition-all"
          >
            <svg class="w-3.5 h-3.5 text-[#0A66C2] fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow z-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="z-10 border-t border-slate-200/80 bg-white mt-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 items-start">
          <!-- Brand & Pills -->
          <div class="md:col-span-5">
            <a href="/" class="inline-flex items-center gap-2.5 group">
              <svg class="w-5 h-5 text-[#1E4620]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 9.74-7 11-3.5-1.26-7-6-7-11V7l7-4z" />
              </svg>
              <span class="text-lg font-bold text-slate-900 tracking-tight group-hover:text-[#1E4620] transition-colors">Jorge Liauw Calo</span>
            </a>

            <p class="text-sm text-slate-500 mt-3.5 leading-relaxed max-w-md">
              Security Engineer at Google Cloud with 13+ years in Cybersecurity. Member of Google Cloud Community BeNeLux &amp; Google Cloud Security Community Amsterdam.
            </p>

            <div class="flex flex-wrap items-center gap-2.5 mt-6">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#F0F4F1] border border-[#DCE5DE] text-[#234F26] text-[11px] font-mono font-bold tracking-wider uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-[#234F26]"></span>
                <span>ENTERPRISE SECURITY</span>
              </span>
              <span class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-[#F1F5F9] border border-slate-200/90 text-slate-600 text-[11px] font-mono font-bold tracking-wider uppercase">
                GOOGLE CLOUD PLATFORM
              </span>
            </div>
          </div>

          <!-- Navigation Column -->
          <div class="md:col-span-3">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-widest text-slate-400 mb-4">
              NAVIGATION
            </h3>
            <ul class="space-y-3 text-sm">
              <li>
                <a
                  href="/"
                  class={`transition-colors ${
                    isHome ? 'text-[#234F26] font-semibold' : 'text-slate-600 hover:text-[#234F26]'
                  }`}
                >
                  Home
                </a>
              </li>
              <li>
                <a
                  href="/posts/"
                  class={`transition-colors ${
                    isArticles ? 'text-[#234F26] font-semibold' : 'text-slate-600 hover:text-[#234F26]'
                  }`}
                >
                  Articles
                </a>
              </li>
              <li>
                <a
                  href="/about/"
                  class={`transition-colors ${
                    isAbout ? 'text-[#234F26] font-semibold' : 'text-slate-600 hover:text-[#234F26]'
                  }`}
                >
                  About Jorge
                </a>
              </li>
              <li>
                <a
                  href="/contact/"
                  class={`transition-colors ${
                    isContact ? 'text-[#234F26] font-semibold' : 'text-slate-600 hover:text-[#234F26]'
                  }`}
                >
                  Contact
                </a>
              </li>
            </ul>
          </div>

          <!-- Engineering Stack Card -->
          <div class="md:col-span-4">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-widest text-slate-400 mb-4">
              ENGINEERING STACK
            </h3>
            <div class="p-5 rounded-2xl bg-[#F6F8F7] border border-slate-200/80">
              <div class="flex items-center gap-2.5 mb-2">
                <span class="inline-flex items-center justify-center w-6 h-5 rounded border border-[#234F26]/50 text-[#234F26] text-[10px] font-mono font-bold">
                  &gt;_
                </span>
                <span class="text-sm font-bold text-slate-900">Production Deployment</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
                Built with Astro &amp; Tailwind CSS for performance, accessibility, and minimal attack surface.
              </p>
            </div>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-slate-200/70 pt-7 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
          <p>&copy; {new Date().getFullYear()} Jorge Liauw Calo. All rights reserved.</p>
          <div class="flex items-center gap-3">
            <a href="/about/" class="hover:text-slate-600 transition-colors">Security &amp; Privacy</a>
            <span>&bull;</span>
            <a href="/posts/" class="hover:text-slate-600 transition-colors">Technical RSS</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
