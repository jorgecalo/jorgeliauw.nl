---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Jorge Liauw Calo | Security Engineer at Google Cloud"
  description="Get in touch with Jorge Liauw Calo for Google Cloud Security inquiries, speaking engagements, or community events in BeNeLux and Amsterdam."
  image="/images/satellite-ground-station.webp"
>
  <!-- Google reCAPTCHA v2 API Script -->
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>

  <section class="py-14 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Info Column -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-semibold block mb-2">Get In Touch</span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
              Let’s Talk Cloud Security
            </h1>
            <p class="text-base text-slate-600 mt-3 leading-relaxed">
              Have a question about Google Cloud Security, speaking at an event, or connecting through the <strong class="text-slate-900">Google Cloud Community BeNeLux</strong> or <strong class="text-slate-900">Google Cloud Security Community Amsterdam</strong>? Fill out the form or connect with me directly on LinkedIn.
            </p>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200/90 bg-white shadow-md">
            <img
              src="/images/satellite-ground-station.webp"
              alt="Satellite Ground Station"
              class="w-full h-48 object-cover"
            />
            <div class="p-5 space-y-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shrink-0">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-500">Direct Network</span>
                  <a
                    href="https://www.linkedin.com/in/jorgeliauw/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-blue-600 hover:underline"
                  >
                    linkedin.com/in/jorgeliauw
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#1E4620] shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-500">Role &amp; Organization</span>
                  <span class="text-sm font-semibold text-slate-900">Security Engineer @ Google Cloud</span>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-cyan-50 border border-cyan-200 flex items-center justify-center text-cyan-700 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-500">Communities</span>
                  <span class="text-sm font-semibold text-slate-900">Google Cloud BeNeLux &amp; Security AMS</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Contact Form Column -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/90 shadow-lg">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Send a Message</h2>

            <!-- Status Alert Box -->
            <div
              id="form-status"
              role="alert"
              class="hidden mb-6 p-4 rounded-xl text-sm font-medium border"
            ></div>

            <form
              id="contact-form"
              action="https://formspree.io/f/mbjwkjvp"
              method="POST"
              class="space-y-5"
            >
              <div>
                <label for="name" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  maxlength="100"
                  placeholder="Jane Doe"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  maxlength="120"
                  placeholder="jane@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Topic / Subject
                </label>
                <input
                  type="text"
                  id="subject"
                  name="_subject"
                  maxlength="150"
                  placeholder="Google Cloud Security Inquiry / Community Event"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="message" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  maxlength="3000"
                  placeholder="Hi Jorge, I'd love to connect regarding..."
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                ></textarea>
              </div>

              <!-- Honeypot anti-spam field -->
              <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />

              <!-- Google reCAPTCHA v2 Widget (Light Theme) -->
              <div class="pt-1 overflow-x-auto">
                <div
                  class="g-recaptcha"
                  data-sitekey="6LeJq9weAAAAAB9ZoTdpLUIdbbtN7Dhd_f-tHN0x"
                  data-theme="light"
                ></div>
              </div>

              <button
                id="submit-btn"
                type="submit"
                class="w-full py-4 px-6 rounded-full font-semibold text-sm bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white shadow-md shadow-blue-500/20 transition-all cursor-pointer"
              >
                Send Message &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusBox = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    function showStatus(message: string, type: 'error' | 'success') {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.classList.remove('hidden', 'bg-red-50', 'border-red-300', 'text-red-800', 'bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
      if (type === 'error') {
        statusBox.classList.add('bg-red-50', 'border-red-300', 'text-red-800');
      } else {
        statusBox.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
      }
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Check if Google reCAPTCHA is loaded and completed
        const recaptchaResponse = (window as any).grecaptcha?.getResponse?.();
        if (!recaptchaResponse) {
          showStatus('Please complete the "I\'m not a robot" reCAPTCHA checkbox before sending your message.', 'error');
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending message...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json',
            },
          });

          if (response.ok) {
            showStatus('Thank you! Your message has been sent successfully. I will get back to you soon.', 'success');
            form.reset();
            (window as any).grecaptcha?.reset?.();
          } else {
            const data = await response.json().catch(() => null);
            const errorMsg = data?.errors?.map((err: any) => err.message).join(', ') || 'Oops! There was a problem submitting your form. Please try again.';
            showStatus(errorMsg, 'error');
          }
        } catch {
          showStatus('Network error while sending message. Please check your connection and try again.', 'error');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message →';
          }
        }
      });
    }
  </script>
</BaseLayout>
