---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Jorge Liauw Calo | Security Engineer at Google Cloud"
  description="Get in touch with Jorge Liauw Calo for Google Cloud Security inquiries, speaking engagements, or community events in BeNeLux and Amsterdam."
  image="/images/satellite-ground-station.webp"
>
  <section class="py-14 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Info Column -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 block mb-2">Get In Touch</span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Let’s Talk Cloud Security
            </h1>
            <p class="text-base text-slate-300 mt-3 leading-relaxed">
              Have a question about Google Cloud Security, speaking at an event, or connecting through the <strong class="text-white">Google Cloud Community BeNeLux</strong> or <strong class="text-white">Google Cloud Security Community Amsterdam</strong>? Fill out the form or connect with me directly on LinkedIn.
            </p>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 shadow-xl">
            <img
              src="/images/satellite-ground-station.webp"
              alt="Satellite Ground Station"
              class="w-full h-48 object-cover"
            />
            <div class="p-5 space-y-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 shrink-0">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-400">Direct Network</span>
                  <a
                    href="https://www.linkedin.com/in/jorgeliauw/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold text-cyan-400 hover:underline"
                  >
                    linkedin.com/in/jorgeliauw
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-400">Role &amp; Organization</span>
                  <span class="text-sm font-semibold text-white">Security Engineer @ Google Cloud</span>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono text-slate-400">Communities</span>
                  <span class="text-sm font-semibold text-white">Google Cloud BeNeLux &amp; Security AMS</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Contact Form Column -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-3xl bg-slate-900/70 border border-slate-800 shadow-2xl">
            <h2 class="text-2xl font-bold text-white mb-6">Send a Message</h2>

            <form
              action="https://formspree.io/f/mbjwkjvp"
              method="POST"
              class="space-y-5"
            >
              <div>
                <label for="name" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  maxlength="100"
                  placeholder="Jane Doe"
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  maxlength="120"
                  placeholder="jane@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 transition-colors"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                  Topic / Subject
                </label>
                <input
                  type="text"
                  id="subject"
                  name="_subject"
                  maxlength="150"
                  placeholder="Google Cloud Security Inquiry / Community Event"
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 transition-colors"
                />
              </div>

              <div>
                <label for="message" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                  Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  maxlength="3000"
                  placeholder="Hi Jorge, I'd love to connect regarding..."
                  class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 transition-colors"
                ></textarea>
              </div>

              <!-- Honeypot anti-spam field -->
              <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />

              <button
                type="submit"
                class="w-full py-4 px-6 rounded-xl font-semibold text-sm bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white shadow-lg shadow-cyan-500/20 transition-all cursor-pointer"
              >
                Send Message &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
