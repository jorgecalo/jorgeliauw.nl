---
import BaseLayout from '../layouts/BaseLayout.astro';

// ============================================================================
// CONTACT FORM CONFIGURATION
// Option A (Recommended - Web3Forms): Paste your free access key from https://web3forms.com
// Option B (Formspree): Leave WEB3FORMS_ACCESS_KEY empty and disable "reCAPTCHA" in Formspree settings
// ============================================================================
const WEB3FORMS_ACCESS_KEY = '';
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mbjwkjvp';

const formAction = WEB3FORMS_ACCESS_KEY
  ? 'https://api.web3forms.com/submit'
  : FORMSPREE_ENDPOINT;
---

<BaseLayout
  title="Contact Jorge Liauw Calo | Security Engineer at Google Cloud"
  description="Get in touch with Jorge Liauw Calo for Google Cloud Security inquiries, speaking engagements, or community events in BeNeLux and Amsterdam."
  image="/images/satellite-ground-station.webp"
>
  <section class="py-14 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Info Column -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-semibold block mb-2">Get In Touch</span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
              Let’s Talk Cloud Security
            </h1>
            <p class="text-base text-slate-600 mt-3 leading-relaxed">
              Have a question about Google Cloud Security, speaking at an event, or connecting through the <strong class="text-slate-900">Google Cloud Community BeNeLux</strong> or <strong class="text-slate-900">Google Cloud Security Community Amsterdam</strong>? Fill out the form or connect with me directly on LinkedIn.
            </p>
          </div>

          <div class="space-y-4 pt-2">
            <a
              href="https://www.linkedin.com/in/jorgeliauw/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-slate-200/90 hover:border-blue-500/40 shadow-sm transition-all group"
            >
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-200/60 flex items-center justify-center text-[#0A66C2] group-hover:bg-[#0A66C2] group-hover:text-white transition-colors">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors">Connect on LinkedIn</div>
                <div class="text-xs text-slate-500 font-mono">linkedin.com/in/jorgeliauw</div>
              </div>
            </a>

            <div class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-200/60 flex items-center justify-center text-[#1E4620]">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-slate-900">Location</div>
                <div class="text-xs text-slate-500 font-mono">Amsterdam, Netherlands (Google Cloud BeNeLux)</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-[#F0F4F1] border border-[#DCE5DE] text-xs text-[#234F26] leading-relaxed">
              <strong class="font-semibold block mb-1">Spam-Protected Contact Form</strong>
              Protected by invisible honeypot &amp; anti-bot verification — no annoying image puzzles required.
            </div>
          </div>
        </div>

        <!-- Right Contact Form Column -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/90 shadow-lg">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Send a Message</h2>

            <!-- Status Alert Box -->
            <div
              id="form-status"
              role="alert"
              class="hidden mb-6 p-4 rounded-xl text-sm font-medium border"
            ></div>

            <form
              id="contact-form"
              action={formAction}
              method="POST"
              class="space-y-5"
            >
              {WEB3FORMS_ACCESS_KEY && (
                <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              )}

              <!-- Invisible Honeypot anti-spam fields (supported by both Formspree & Web3Forms) -->
              <input type="text" name="_gotcha" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

              <div>
                <label for="name" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  maxlength="100"
                  placeholder="Jane Doe"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  maxlength="120"
                  placeholder="jane@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Topic / Subject
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  maxlength="150"
                  placeholder="Google Cloud Security Inquiry / Community Event"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="message" class="block text-xs font-mono uppercase tracking-wider text-slate-600 font-semibold mb-2">
                  Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  maxlength="3000"
                  placeholder="Hi Jorge, I'd love to connect regarding..."
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:bg-white transition-colors"
                ></textarea>
              </div>

              <button
                id="submit-btn"
                type="submit"
                class="w-full py-4 px-6 rounded-full font-semibold text-sm bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white shadow-md shadow-blue-500/20 transition-all cursor-pointer"
              >
                Send Message &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusBox = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const formLoadedAt = Date.now();

    function showStatus(message: string, type: 'error' | 'success') {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.classList.remove('hidden', 'bg-red-50', 'border-red-300', 'text-red-800', 'bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
      if (type === 'error') {
        statusBox.classList.add('bg-red-50', 'border-red-300', 'text-red-800');
      } else {
        statusBox.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
      }
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Anti-bot timing check (block automated scripts submitting in under 1.2 seconds)
        if (Date.now() - formLoadedAt < 1200) {
          showStatus('Please wait a moment before submitting the form.', 'error');
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending message...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              Accept: 'application/json',
            },
          });

          if (response.ok) {
            showStatus('Thank you! Your message has been sent successfully. I will get back to you soon.', 'success');
            form.reset();
          } else {
            const data = await response.json().catch(() => null);
            const rawError = data?.errors?.map((err: any) => err.message).join(', ') || data?.message || '';
            if (rawError.toLowerCase().includes('recaptcha')) {
              showStatus(
                'Formspree reCAPTCHA is enabled on the server. To fix this: open your Formspree Dashboard → Form Settings → Spam Protection and toggle OFF "reCAPTCHA" (or switch to Web3Forms).',
                'error'
              );
            } else {
              showStatus(rawError || 'Oops! There was a problem submitting your form. Please try again.', 'error');
            }
          }
        } catch {
          showStatus('Network error while sending message. Please check your connection and try again.', 'error');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message →';
          }
        }
      });
    }
  </script>
</BaseLayout>
