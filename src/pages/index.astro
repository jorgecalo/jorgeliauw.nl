---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 6);
---

<BaseLayout
  title="Jorge Liauw Calo | Security Engineer at Google Cloud"
  description="Security Engineer at Google Cloud with 13+ years of experience in Cybersecurity across highly regulated industries including Semiconductor, Banking, Fintech, and Insurance."
>
  <!-- Hero Section -->
  <section class="relative pt-10 pb-16 lg:pt-16 lg:pb-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-[#1E4620] text-xs font-mono font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#34A853] animate-ping"></span>
            <span>Security Engineer @ Google Cloud &bull; Google Cybershield</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
            Architecting Resilient <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-600 to-emerald-600">Google Cloud Security</span>
          </h1>

          <!-- Mission Tagline Callout -->
          <div class="relative pl-4 sm:pl-5 py-2.5 border-l-4 border-blue-600 bg-gradient-to-r from-blue-50/90 via-cyan-50/40 to-transparent rounded-r-xl max-w-2xl shadow-sm">
            <p class="text-base sm:text-lg font-medium text-slate-800 tracking-wide">
              &ldquo;Our goal is bigger than securing Google &mdash; it&rsquo;s about <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-emerald-600 font-bold">securing the internet</span>.&rdquo;
            </p>
          </div>

          <p class="text-lg sm:text-xl text-slate-700 leading-relaxed max-w-2xl">
            Hi, I’m <strong class="text-slate-900 font-bold">Jorge Liauw Calo</strong> — a <strong class="text-blue-600 font-semibold">Security Engineer at Google Cloud</strong> and part of the <strong class="text-[#1E4620] font-semibold">Google Cybershield team</strong>. With over 13 years of experience in Cybersecurity, I work with customers in high-security and highly regulated industries including <strong class="text-slate-900">Semiconductor, Banking, Fintech, and Insurance</strong>.
          </p>

          <p class="text-base text-slate-600 leading-relaxed max-w-2xl">
            I am an active member of the <strong class="text-slate-800">Google Cloud Community BeNeLux</strong> and <strong class="text-slate-800">Google Cloud Security Community Amsterdam</strong>. Here I share practical guides on assessing and improving the security of your workloads and data on Google Cloud—from IAM, Organization Policies, and Cloud Custodian to ransomware defense and DevSecOps.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/posts/"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-sm font-semibold bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white shadow-md shadow-blue-500/20 transition-all"
            >
              <span>Browse All Articles ({allPosts.length})</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/about/"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-sm font-semibold bg-white hover:bg-slate-50 border border-slate-200/90 text-slate-700 shadow-sm transition-all"
            >
              <span>About Jorge</span>
            </a>
          </div>

          <!-- Highlights Bar -->
          <div class="pt-6 grid grid-cols-3 gap-4 border-t border-slate-200/80 max-w-lg">
            <div>
              <span class="block text-2xl font-extrabold text-slate-900">13+</span>
              <span class="text-xs font-mono text-slate-500">Years in Cybersecurity</span>
            </div>
            <div>
              <span class="block text-2xl font-extrabold text-blue-600">Cybershield</span>
              <span class="text-xs font-mono text-slate-500">Google Cloud Security</span>
            </div>
            <div>
              <span class="block text-2xl font-extrabold text-[#1E4620]">BeNeLux &amp; AMS</span>
              <span class="text-xs font-mono text-slate-500">Cloud Security Communities</span>
            </div>
          </div>
        </div>

        <!-- Right Visual Column -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Soft glow frame -->
            <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-blue-400 via-cyan-400 to-emerald-400 opacity-20 blur-xl"></div>

            <!-- Main Presenter Image Card -->
            <div class="relative rounded-2xl bg-white border border-slate-200/90 overflow-hidden shadow-xl">
              <img
                src="/images/jorge-google-cloud-portrait.png"
                alt="Jorge Liauw Calo — Security Engineer at Google Cloud"
                class="w-full h-72 sm:h-80 object-cover object-center"
              />
              <div class="p-5 bg-white border-t border-slate-200/80 flex items-center justify-between gap-4">
                <div>
                  <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-semibold block">Community &amp; Speaking</span>
                  <p class="text-sm font-bold text-slate-900 mt-0.5">Google Cloud Community BeNeLux &amp; Security Community Amsterdam</p>
                </div>
                <a
                  href="https://www.linkedin.com/in/jorgeliauw/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700 transition-colors"
                >
                  Connect &rarr;
                </a>
              </div>
            </div>

            <!-- Floating Partner All-Star Badge Card -->
            <div class="mt-4 p-4 rounded-2xl bg-white border border-slate-200/90 flex items-center gap-4 shadow-md">
              <img
                src="/images/Google_Cloud_Partner_All-stars_Solutions-Engineering_Delivery_Jorge_Liauw_Calo-2022.png"
                alt="Google Cloud Partner All-Stars Award"
                class="w-16 h-16 object-contain shrink-0 rounded-xl bg-slate-50 p-1.5 border border-slate-200/80"
              />
              <div>
                <div class="text-xs font-mono text-amber-600 font-bold">RECOGNITION &bull; DEC 2022</div>
                <h2 class="text-sm font-bold text-slate-900">Google Cloud Partner All-Star</h2>
                <p class="text-xs text-slate-600 mt-0.5">Awarded for excellence in Solutions Engineering &amp; Delivery</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Pillars -->
  <section class="py-12 border-y border-slate-200/80 bg-slate-100/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200/80 flex items-center justify-center text-blue-600 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Regulated Cloud Security</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Designing defense-in-depth foundations on Google Cloud for high-security industries (Semiconductor, Banking, Fintech, Insurance): IAM least privilege, Organization Policy constraints, and Zero Trust.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-200/80 flex items-center justify-center text-cyan-600 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Policy-as-Code &amp; Cloud Custodian</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Automating compliance and governance with Cloud Custodian policies, real-time Cloud Monitoring metrics, CFT Scorecard, and Shift-Left DevSecOps pipelines in Cloud Build.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-[#1E4620] mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Community &amp; Knowledge Sharing</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Active in the Google Cloud Community BeNeLux and Google Cloud Security Community Amsterdam, hosting Cloud Security sessions, and helping enterprise engineering teams level up their cloud posture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-blue-600 font-semibold block mb-2">Technical Blog</span>
          <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Recent Articles &amp; Guides</h2>
        </div>
        <a
          href="/posts/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors"
        >
          <span>View all {allPosts.length} articles</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => <PostCard post={post} />)}
      </div>

      <div class="mt-14 text-center">
        <a
          href="/posts/"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-sm font-semibold bg-white hover:bg-slate-50 border border-slate-200/90 text-slate-800 transition-all shadow-sm"
        >
          <span>Explore Full Archive ({allPosts.length} Posts)</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
