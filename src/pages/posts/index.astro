---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = Array.from(new Set(sortedPosts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title="Technical Articles & Guides | Jorge Liauw Calo"
  description="All 24 articles on Google Cloud Security, Cloud Custodian, Policy-as-Code, IAM, Ransomware Defense, and Cloud Engineering."
>
  <section class="py-14 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 block mb-2">Knowledge Base</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
          Articles &amp; Technical Guides
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Deep dives into Google Cloud Security, Cloud Custodian policy-as-code, Cloud Foundation Toolkit, and lessons learned from 13+ years in Cloud &amp; Cybersecurity.
        </p>
      </div>

      <!-- Search & Tag Filters -->
      <div class="mb-10 space-y-4 bg-slate-900/60 border border-slate-800/80 p-5 rounded-2xl">
        <div class="relative">
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Search articles by title, topic, or keyword (e.g. Custodian, IAM, Ransomware)..."
            class="w-full pl-12 pr-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-500 transition-colors"
          />
        </div>

        <div class="flex flex-wrap items-center gap-2 pt-1">
          <span class="text-xs font-mono text-slate-400 mr-1">Filter by topic:</span>
          <button
            type="button"
            data-tag="all"
            class="tag-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-cyan-500 text-slate-950 transition-all"
          >
            All ({sortedPosts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="tag-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-slate-950 text-slate-300 hover:text-white border border-slate-800 transition-all"
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <!-- Posts Grid -->
      <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <div
            class="post-item"
            data-title={post.data.title.toLowerCase()}
            data-desc={(post.data.description || '').toLowerCase()}
            data-tags={post.data.tags.join(',')}
          >
            <PostCard post={post} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results" class="hidden text-center py-16 bg-slate-900/40 rounded-2xl border border-slate-800/60">
        <p class="text-lg font-semibold text-white mb-1">No matching articles found</p>
        <p class="text-sm text-slate-400">Try clearing your search query or selecting a different topic tag.</p>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.tag-filter-btn');
    const postItems = document.querySelectorAll('.post-item');
    const noResults = document.getElementById('no-results');

    let activeTag = 'all';
    let searchQuery = '';

    function filterPosts() {
      let visibleCount = 0;
      postItems.forEach((item) => {
        const el = item as HTMLElement;
        const title = el.dataset.title || '';
        const desc = el.dataset.desc || '';
        const tags = (el.dataset.tags || '').split(',');

        const matchesTag = activeTag === 'all' || tags.includes(activeTag);
        const matchesSearch =
          searchQuery === '' ||
          title.includes(searchQuery) ||
          desc.includes(searchQuery) ||
          tags.some((t) => t.toLowerCase().includes(searchQuery));

        if (matchesTag && matchesSearch) {
          el.classList.remove('hidden');
          visibleCount++;
        } else {
          el.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterPosts();
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.className =
            'tag-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-slate-950 text-slate-300 hover:text-white border border-slate-800 transition-all';
        });
        btn.className =
          'tag-filter-btn px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-cyan-500 text-slate-950 transition-all';

        activeTag = (btn as HTMLElement).dataset.tag || 'all';
        filterPosts();
      });
    });
  </script>
</BaseLayout>
