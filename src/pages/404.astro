---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | Jorge Liauw Calo">
  <section class="py-24 text-center">
    <div class="max-w-xl mx-auto px-4">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-50 border border-blue-200 text-blue-600 font-mono text-2xl font-bold mb-6 shadow-sm">
        404
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Page Not Found</h1>
      <p class="text-slate-600 mb-8">
        The page or article you are looking for might have been moved or renamed.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="px-6 py-3 rounded-full text-sm font-semibold bg-gradient-to-r from-blue-600 to-cyan-600 text-white shadow-md"
        >
          Return Home
        </a>
        <a
          href="/posts/"
          class="px-6 py-3 rounded-full text-sm font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-sm"
        >
          Browse All Articles
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
